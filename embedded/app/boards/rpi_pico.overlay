&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};


&pwm {
	status="okay";
	pinctrl-0 = <&pwm_ch3a_default>;
	pinctrl-names = "default";
	divider-int-4 = <255>;
};


&pinctrl {
	pwm_ch3a_default: pwm_ch3a_default {
		group1 {
			pinmux = <PWM_3A_P22>;
		};
	};
};
